{
  "expo": {
    "name": "midespensa",
    "slug": "midespensa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "scheme": "midespensa",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Despensa usa la cámara para escanear tus compras y registrarlas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Despensa usa tus fotos para escanear tus compras y registrarlas."
        }
      ],
      "expo-secure-store"
    ],
    "newArchEnabled": true
  }
}

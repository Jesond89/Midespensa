{
  "expo": {
    "name": "midespensa",
    "slug": "midespensa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.devcore.midespensa",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.devcore.midespensa",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "scheme": "midespensa",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Despensa usa la cámara para escanear tus compras y registrarlas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Despensa usa tus fotos para escanear tus compras y registrarlas.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9d0621d-609c-48aa-8715-73877d47b730"
      }
    },
    "owner": "antonionoriega"
  }
}